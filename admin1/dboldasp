<script>
(() => {
  // === KAPSÜLLÜ MODÜL — tek global: window.SessionGuard ===
  const SG = {
    cfg: {
      pingUrl: 'session.asp',
      loginUrl: 'index.asp?iframe=open&redirect=0',
      pingMs: 30000,             // 30sn
      countdownTickMs: 1000,     // 1sn
      sessionDurationMin: 120,   // ASP'den de alabiliriz
      modalId: 'sessionModal',
      iframeId: 'loginIframe',
      countdownElId: 'countdownTimer',
    },
    _state: {
      sessionTimeLeft: 0,
      lastTick: Date.now(),
      modalOpened: false,
      pollId: null,
      countdownId: null,
      inited: false,
    },

    init(userCfg = {}) {
      if (this._state.inited) return;
      this._state.inited = true;

      // Kullanıcı config’i uygula
      Object.assign(this.cfg, userCfg);

      // Başlangıç süre
      this._state.sessionTimeLeft = (this.cfg.sessionDurationMin || 120) * 60;

      // Kapat butonu varsa içerden dinleyici ekle (global closeModal tanımlamıyoruz)
      const modal = document.getElementById(this.cfg.modalId);
      if (modal) {
        const btn = modal.querySelector('[data-sg-close], button[onclick="closeModal()"]');
        if (btn) {
          btn.addEventListener('click', () => this._closeModalInternal());
        }
      }

      // Sayaç + polling
      window.addEventListener('load', () => {
        this._startCountdown();
        if (!document.hidden) this._startPolling();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this._stopPolling();
        } else if (!this._state.modalOpened) {
          // sekme geri geldiğinde hemen kontrol
          this._pingSession();
          this._startPolling();
          this._state.lastTick = Date.now();
        }
      });
    },

    // Dışarıdan çağrılacak: giriş tamamlandıktan sonra
    sessionRenewed() {
      if (this._state.modalOpened) {
        this._closeModalInternal();
      }
      this._resetTimerToFull();
      if (!document.hidden) this._startPolling();
    },

    // UI yardımcıları
    _getEl(id) { return document.getElementById(id); },
    _updateCountdownUI() {
      const el = this._getEl(this.cfg.countdownElId);
      if (!el) return;
      const mm = Math.max(0, Math.floor(this._state.sessionTimeLeft / 60));
      const ss = Math.max(0, this._state.sessionTimeLeft % 60);
      el.textContent = `${mm} dk ${ss} sn`;
    },
    _openModalOnce() {
      if (this._state.modalOpened) return;
      this._state.modalOpened = true;

      const iframe = this._getEl(this.cfg.iframeId);
      if (iframe) {
        iframe.src = this.cfg.loginUrl;
        iframe.style.display = 'block';
      }
      const modal = this._getEl(this.cfg.modalId);
      if (modal) modal.style.display = 'block';

      this._stopCountdown();
      this._stopPolling();

      // Event tetikle (istersen diğer scriptlerin dinlemesi için)
      document.dispatchEvent(new CustomEvent('session:expired'));
    },
    _closeModalInternal() {
      const modal = this._getEl(this.cfg.modalId);
      if (modal) modal.style.display = 'none';
      this._state.modalOpened = false;
      this._resetTimerToFull();
      this._startCountdown();
      document.dispatchEvent(new CustomEvent('session:renewed'));
    },
    _resetTimerToFull() {
      this._state.sessionTimeLeft = (this.cfg.sessionDurationMin || 120) * 60;
      this._state.lastTick = Date.now();
      this._updateCountdownUI();
    },

    // Sayaç
    _tickCountdown() {
      const now = Date.now();
      const elapsed = Math.floor((now - this._state.lastTick) / 1000);
      if (elapsed > 0) {
        this._state.sessionTimeLeft = Math.max(0, this._state.sessionTimeLeft - elapsed);
        this._state.lastTick = now;
        this._updateCountdownUI();
        if (this._state.sessionTimeLeft <= 0 && !this._state.modalOpened) {
          this._pingSession(); // sunucu otoritesi ile karar ver
        }
      }
    },
    _startCountdown() {
      if (this._state.countdownId) return;
      this._state.lastTick = Date.now();
      this._updateCountdownUI();
      this._state.countdownId = setInterval(() => this._tickCountdown(), this.cfg.countdownTickMs);
    },
    _stopCountdown() {
      if (this._state.countdownId) {
        clearInterval(this._state.countdownId);
        this._state.countdownId = null;
      }
    },

    // Polling
    _startPolling() {
      if (this._state.pollId) return;
      this._pingSession(); // hemen bir kez
      this._state.pollId = setInterval(() => {
        if (!document.hidden && !this._state.modalOpened) this._pingSession();
      }, this.cfg.pingMs);
    },
    _stopPolling() {
      if (this._state.pollId) {
        clearInterval(this._state.pollId);
        this._state.pollId = null;
      }
    },

    // Sunucu yanıtını normalize et
    _parseExpired(text) {
      try {
        const data = JSON.parse(text);
        if (typeof data.expired === 'boolean') return data.expired;
        if (typeof data.expired === 'string') return data.expired.toLowerCase() === 'true';
      } catch (e) {
        const t = (text || '').trim().toLowerCase();
        if (t === 'true') return true;
        if (t === 'false') return false;
      }
      return false;
    },

    async _pingSession() {
      try {
        const res = await fetch(this.cfg.pingUrl + '?_=' + Date.now(), {
          method: 'GET',
          cache: 'no-store',
          headers: { 'Accept': 'application/json, text/plain; q=0.9' }
        });
        if (!res.ok) {
          if (res.status === 401 || res.status === 440) this._openModalOnce();
          return;
        }
        const text = await res.text();
        const expired = this._parseExpired(text);
        if (expired) {
          this._openModalOnce();
        } else {
          // Sliding expiration: başarılı her ping’de süreyi full’e sar
          this._resetTimerToFull();
        }
      } catch (e) {
        // Ağ hatası → sessiz; bir sonraki ping denesin
      }
    }
  };

  // Dışa açılan tek global
  window.SessionGuard = {
    init: (cfg) => SG.init(cfg),
    sessionRenewed: () => SG.sessionRenewed(),
    // İstersen debug için şu ikisini de açabilirsin:
    // openModal: () => SG._openModalOnce(),
    // closeModal: () => SG._closeModalInternal(),
  };
})();
</script>

<script>
/* ------ projen için başlat ------ */
SessionGuard.init({
  // ASP değeri varsa onu kullan (dakika). Yoksa default 120.
  sessionDurationMin: parseInt("<%=sessionDuration%>", 10) || 120,
  // endpoint’lerini özelleştir
  pingUrl: 'session.asp',
  loginUrl: 'index.asp?iframe=open&redirect=0',
  // ID'ler senin HTML'ine uyuyor
  modalId: 'sessionModal',
  iframeId: 'loginIframe',
  countdownElId: 'countdownTimer',
  // süreler
  pingMs: 30000,
  countdownTickMs: 1000
});

// örnek: iframe içinden parent.SessionGuard.sessionRenewed() çağır

window.addEventListener('message', (e) => {
  // Güvenlik için origin kontrolü yap (ör: if (e.origin !== 'https://seninsite.com') return;)
  if (e.data && e.data.type === 'SESSION_RENEWED') {
    if (window.SessionGuard) window.SessionGuard.sessionRenewed();
  }
});
</script>


<script>
(function(){
  const CENTRAL = 'https://ai.cloudgrafike.com/aiassistant/src/quota_summary.php';

  function sanitizeHost(h){
    return (h||'').toLowerCase().replace(/^https?:\/\//,'').replace(/^www\./,'').replace(/\/.*$/,'');
  }

  async function fetchFromCentral(domain){
    const r = await fetch(CENTRAL + '?domain=' + encodeURIComponent(domain), {method:'GET', credentials:'omit', cache:'no-store'});
    if(!r.ok) throw new Error('central '+r.status);
    return await r.json();
  }
  async function fetchFromProxy(domain){
    const r = await fetch('/admin/opt/quota_status.php?domain=' + encodeURIComponent(domain), {method:'GET', credentials:'same-origin', cache:'no-store'});
    if(!r.ok) throw new Error('proxy '+r.status);
    return await r.json();
  }
  async function fetchQuota({domain, viaProxy}){
    const d = sanitizeHost(domain || location.hostname);
    if(viaProxy) return await fetchFromProxy(d);
    try { return await fetchFromCentral(d); }
    catch { return await fetchFromProxy(d); }
  }

  function mountQuotaBadge(target, data, opts){
    const el = (typeof target==='string') ? document.querySelector(target) : target;
    if(!el) return;
    const h    = Number(opts?.height || 40);              // kırmızı sayaç yüksekliğine eşitle
    const mode = data.mode || 'stopped';
    const lim  = data.limits || {normal:10, lite:100};
    const rem  = data.remaining || {normal:0, lite:0};
    const used = data.used || {normal:0, lite:0, errors:0};
    const modeLabel = mode==='normal' ? 'G' : mode==='lite' ? 'L' : 'K';

    el.innerHTML = `
      <div class="aiq-wrap">
        <button type="button" class="aiq-badge" data-mode="${mode}" style="--aiq-h:${h}px" aria-haspopup="true" aria-expanded="false" title="Kota">
          <span class="dot" aria-hidden="true"></span>
          <span class="kv">Gelişmiş <b>${rem.normal}</b><small> / ${lim.normal}</small></span>
          <span class="kv">Lite <b>${rem.lite}</b><small> / ${lim.lite}</small></span>
          <span class="kv">Mod <b>${modeLabel}</b></span>
          <span class="toggle" aria-hidden="true" style=" width: auto; padding-top: inherit; "><span class=" fa fa-angle-down"></span></span>
        </button>
        <div class="aiq-dd" role="menu">
          <div class="dd-row"><strong>Bu ay</strong></div>
          <div class="dd-row">Gelişmiş kullanımı: <b>${used.normal}</b></div>
          <div class="dd-row">Lite kullanımı: <b>${used.lite}</b></div>
          <div class="dd-row">Hata: <b>${used.errors}</b></div>
        </div>
      </div>
    `;

    const wrap   = el.querySelector('.aiq-wrap');
    const badge  = el.querySelector('.aiq-badge');
    const panel  = el.querySelector('.aiq-dd');

    function open(){ panel.classList.add('open'); badge.setAttribute('aria-expanded','true'); document.addEventListener('click', outside); }
    function close(){ panel.classList.remove('open'); badge.setAttribute('aria-expanded','false'); document.removeEventListener('click', outside); }
    function outside(ev){ if(!wrap.contains(ev.target)) close(); }

    badge.addEventListener('click', (e)=>{ e.stopPropagation(); panel.classList.toggle('open'); 
      if(panel.classList.contains('open')) open(); else close();
    });
  }

  // Dışarıdan çağrı noktası
  window.initQuotaWidget = async function initQuotaWidget(opts){
    const target   = opts?.target || '#ai-quota-badge';
    const domain   = opts?.domain || location.hostname;
    const viaProxy = !!opts?.viaProxy;           // CORS sorunu varsa true yap
    const height   = Number(opts?.height || 40); // kırmızı sayaç yüksekliği

    try{
      const data = await fetchQuota({domain, viaProxy});
      mountQuotaBadge(target, data, {height});
    }catch(e){
      console.error('quota badge failed', e);
      const el = document.querySelector(target);
      if(el) el.innerHTML = '<div class="aiq-fallback">Kota bilgisi alınamadı</div>';
    }
  };

  // Stiller
  const css = `
  .aiq-wrap{ position:relative; display:inline-block; }
  .aiq-badge{
    --aiq-h:40px;
    display:inline-flex; align-items:center; gap:12px;
    min-height:var(--aiq-h); line-height:var(--aiq-h);
    padding:0 12px; border:1px solid #e5e7eb; border-radius:10px; background:#fff; cursor:pointer;
    font:14px/1 system-ui,-apple-system,Segoe UI,Roboto,Arial; white-space:nowrap;
    box-shadow:0 1px 2px rgba(0,0,0,.04);
  }
  .aiq-badge .dot{width:8px;height:8px;border-radius:50%;background:#0aa;margin-right:2px}
  .aiq-badge[data-mode="lite"] .dot{background:#2563eb}
  .aiq-badge[data-mode="stopped"] .dot{background:#ef4444}
