<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- HTTPS redirect -->
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Dinamik Access-Control-Allow-Origin -->
        <rule name="Dynamic CORS Origin">
          <match serverVariable="RESPONSE_Access-Control-Allow-Origin" pattern=".*" />
          <conditions>
            <add input="{HTTP_ORIGIN}" pattern=".+" />
          </conditions>
          <action type="Rewrite" value="{HTTP_ORIGIN}" />
        </rule>
        <rule name="Fallback to Host" preCondition="NoOrigin">
          <match serverVariable="RESPONSE_Access-Control-Allow-Origin" pattern=".*" />
          <action type="Rewrite" value="https://{HTTP_HOST}" />
        </rule>
        <preConditions>
          <preCondition name="NoOrigin">
            <add input="{HTTP_ORIGIN}" pattern="^$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Methods" value="GET,POST,OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Origin, X-Requested-With, Content-Type, Accept, Authorization" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Dynamic IP Restrictions -->
    <security>
      <dynamicIpSecurity enableLoggingOnlyMode="false">
        <denyByConcurrentRequests enabled="true" maxConcurrentRequests="20" />
        <denyByRequestRate enabled="true" maxRequests="50" requestIntervalInMilliseconds="60000" />
      </dynamicIpSecurity>
    </security>

    <!-- Request Filtering -->
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="2048" maxUrl="2048" />
        <!-- İstersen maxAllowedContentLength ile POST body limiti koyabilirsin -->
        <!-- <requestLimits maxAllowedContentLength="10485760" /> 10 MB -->
      </requestFiltering>
    </security>

    <!-- Error pages -->
    <httpErrors errorMode="Custom">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.asp" responseMode="ExecuteURL" />
      <remove statusCode="500" />
      <error statusCode="500" path="/500.asp" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>
</configuration>
